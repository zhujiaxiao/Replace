# Obtain your own SCNet key. Never share a populated .env.
SCNET_API_KEY=
SCNET_BASE_URL=https://api.scnet.cn/api/llm/v1
SCNET_VIDEO_MODEL=SeeDance-2-5-LumaCraft
# Catalog: Seedance2.0, SeeDance-2-5-LumaCraft, SeeDance-2.0-LumaCraft,
# Qwen-Image-3.0-LumaCraft, Minimax-H3-LumaCraft, Minimax-H3-Max-LumaCraft,
# Qwen3-Embedding-8B. The current Studio workflow exposes video-capable models.
# scnet (provider-native, recommended), tmpfiles, or catbox
MEDIA_HOST=scnet
# Comma-separated fallback hosts. Catbox is public and persistent; leave empty to disable.
MEDIA_HOST_FALLBACKS=
CATBOX_USERHASH=
